generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  JOB_SEEKER
  COMPANY
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole @default(JOB_SEEKER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  jobs          Job[]          @relation("CompanyJobs")
  savedJobs     SavedJob[]
  applications  Application[]
  notifications Notification[]

  @@index([role])
  @@index([createdAt])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  phone          String?
  location       String?
  headline       String?
  bio            String?  @db.Text
  skills         Json?
  education      String?  @db.Text
  experience     String?  @db.Text
  resumeUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  profilePicture String?
  completion     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id             String    @id @default(cuid())
  companyId      String
  title          String
  description    String    @db.Text
  requirements   String?   @db.Text
  location       String?
  workMode       String?
  jobType        JobType   @default(FULL_TIME)
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String    @default("INR")
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      User          @relation("CompanyJobs", fields: [companyId], references: [id], onDelete: Restrict)
  savedBy      SavedJob[]
  applications Application[]

  @@index([companyId])
  @@index([isActive, createdAt])
  @@index([location])
  @@index([jobType])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  status      ApplicationStatus @default(APPLIED)
  coverLetter String?           @db.Text
  resumeUrl   String?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model EmailOtp {
  email     String   @id @db.VarChar(191)
  codeHash  String   @db.VarChar(64)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(191)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
}
